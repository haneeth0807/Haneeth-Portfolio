# URL of the backend API.
# - Local dev:  http://localhost:8001
# - Production: https://your-backend-url.com   (set this in Vercel's Environment Variables)
REACT_APP_BACKEND_URL=http://localhost:8001

# Dev-server WebSocket port — leave as 3000 locally, not needed in production
WDS_SOCKET_PORT=3000

ENABLE_HEALTH_CHECK=false
