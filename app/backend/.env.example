# MongoDB connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db

# Allowed CORS origins (use * for dev, your domain for prod)
CORS_ORIGINS=*

# Gmail credentials for sending contact form emails
# GMAIL_USER: your full Gmail address
# GMAIL_APP_PASSWORD: 16-char App Password from Google Account → Security → App passwords
EMAIL_FROM_NAME=Haneeth Raja Portfolio
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
OWNER_EMAIL=your@email.com

# GitHub username for the contributions graph
GITHUB_USER=your_github_username
